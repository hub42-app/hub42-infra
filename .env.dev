# Development Environment Configuration
# Use with: docker-compose -f docker-compose.dev.yml up -d

# Database
DB_USER=admin
DB_PASSWORD=password

# Security
JWT_SECRET=this-is-a-very-secure-secret-key-for-development-that-is-long-enough

# Optional: Observability (can be empty for dev)
SENTRY_DSN=
SENTRY_TRACES_RATE=

# Optional: Email (can be empty for dev)
MAIL_HOST=
MAIL_PORT=

# Optional: URLs (dev defaults work fine)
APP_BASE_URL=http://hub42.local:5173
PORTAL_BASE_URL=http://hub42.local:5174
MAIL_FROM=noreply@hub42.local
