# ============================================================================
# Hub42 Caddy Configuration
# Internal Docker Network + Selective External API
# Subdomain-based routing for portals
# ============================================================================

# ============================================================================
# Global Configuration (MUST BE FIRST)
# ============================================================================

{
  log {
    level INFO
    format json
  }
}

# ============================================================================
# Global Security Headers
# ============================================================================
(security_headers) {
  header X-Content-Type-Options nosniff
  header X-Frame-Options DENY
  header X-XSS-Protection "1; mode=block"
  header Referrer-Policy "strict-origin-when-cross-origin"
}

# ============================================================================
# CRM Portal (crm.hub42.app)
# ============================================================================
crm.hub42.app {
  import security_headers

  # API requests to backend
  handle /api/v1* {
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Frontend files
  reverse_proxy business-portal:80 {
    header_up X-Forwarded-For {http.request.remote}
    header_up X-Forwarded-Proto https
  }
}

# ============================================================================
# Admin Portal (admin.hub42.app)
# ============================================================================
admin.hub42.app {
  import security_headers

  # API requests to backend
  handle /api/v1/admin* {
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
