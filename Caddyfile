:8080 {
  @api host api.hub42.app
  @crm host crm.hub42.app
  @admin host admin.hub42.app
  @portal host portal.hub42.app
  @scanner host scanner.hub42.app
  @landing host hub42.app
  @health path /health

  handle @health {
    respond 200
  }
  handle @api {
    reverse_proxy backend:8081
  }
  handle @crm {
    reverse_proxy business-portal:80
  }
  handle @admin {
    reverse_proxy admin-portal:80
  }
  handle @portal {
    reverse_proxy customer-portal:80
  }
  handle @scanner {
    reverse_proxy scanner:80
  }
  handle @landing {
    reverse_proxy landing:80
  }
}
