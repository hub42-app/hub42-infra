# ============================================================================
# Landing Page & Root (hub42.app, www.hub42.app)
# ============================================================================
hub42.app, www.hub42.app {
  import security_headers

  # API requests to backend
  handle /api/* {
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Frontend files
  reverse_proxy landing:80 {
    header_up X-Forwarded-For {http.request.remote}
    header_up X-Forwarded-Proto https
  }
}

# ============================================================================
# api.hub42.app - Integration API Only (Block Internal Endpoints)
# ============================================================================
api.hub42.app {
  import security_headers

  # Security: Block any attempt to access internal endpoints
  @internal {
    path /api/internal/*
  }
  handle @internal {
    respond "Internal API not accessible externally" 403
  }

  # Route integration endpoints
  @integration {
    path /api/integration/*
  }
  handle @integration {
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Health endpoint for monitoring
  handle /health {
    reverse_proxy backend:8081
  }

  # Reject everything else
  respond "Not found" 404
}
