:8080 {
  @api host api.hub42.local
  @crm host crm.hub42.local
  @admin host admin.hub42.local
  @portal host portal.hub42.local
  @scanner host scanner.hub42.local
  @landing host hub42.local
  @health path /health

  handle @health {
    respond 200
  }
  handle @api {
    reverse_proxy hub42-backend:8081
  }
  handle @crm {
    reverse_proxy hub42-business-portal:5173
  }
  handle @admin {
    reverse_proxy hub42-admin-portal:5175
  }
  handle @portal {
    reverse_proxy hub42-customer-portal:5174
  }
  handle @scanner {
    reverse_proxy hub42-scanner:5176
  }
  handle @landing {
    reverse_proxy hub42-landing:5177
  }
}
