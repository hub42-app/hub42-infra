# ============================================================================
# Hub42 Caddy Configuration
# Internal Docker Network + Selective External API
# Subdomain-based routing for portals
# ============================================================================

# ============================================================================
# Global Configuration (MUST BE FIRST)
# ============================================================================

{
  log {
    level INFO
    format json
  }
}

# ============================================================================
# Global Security Headers
# ============================================================================
(security_headers) {
  header X-Content-Type-Options nosniff
  header X-Frame-Options DENY
  header X-XSS-Protection "1; mode=block"
  header Referrer-Policy "strict-origin-when-cross-origin"
}

# ============================================================================
# CRM Portal (crm.hub42.app)
# ============================================================================
crm.hub42.app {
  import security_headers

  # API requests to backend (with path rewriting)
  @api path /v1/* /iam/* /auth/* /crm/* /billing/* /portal/*
  handle @api {
    rewrite * /api/internal{path}
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Frontend files (default)
  reverse_proxy business-portal:80 {
    header_up X-Forwarded-For {http.request.remote}
    header_up X-Forwarded-Proto https
  }
}

# ============================================================================
# Admin Portal (admin.hub42.app)
# ============================================================================
admin.hub42.app {
  import security_headers

  # API requests to backend (with path rewriting)
  @api path /admin/* /v1/admin/*
  handle @api {
    rewrite * /api/internal{path}
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Frontend files (default)
  reverse_proxy admin-portal:80 {
    header_up X-Forwarded-For {http.request.remote}
    header_up X-Forwarded-Proto https
  }
}

# ============================================================================
# Customer Portal (customer.hub42.app)
# ============================================================================
customer.hub42.app {
  import security_headers

  # Internal API requests to backend (with path rewriting)
  @internal_api path /v1/* /portal/*
  handle @internal_api {
    rewrite * /api/internal{path}
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Integration API requests to backend (with path rewriting)
  @integration path /integration/*
  handle @integration {
    rewrite * /api{path}
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Frontend files (default)
  reverse_proxy customer-portal:80 {
    header_up X-Forwarded-For {http.request.remote}
    header_up X-Forwarded-Proto https
  }
}

# ============================================================================
# Scanner Portal (scanner.hub42.app)
# ============================================================================
scanner.hub42.app {
  import security_headers

  # API requests to backend (with path rewriting)
  @api path /v1/*
  handle @api {
    rewrite * /api/internal{path}
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Frontend files (default)
  reverse_proxy scanner:80 {
    header_up X-Forwarded-For {http.request.remote}
    header_up X-Forwarded-Proto https
  }
}

# ============================================================================
# Landing Page & Root (hub42.app, www.hub42.app)
# ============================================================================
hub42.app, www.hub42.app {
  import security_headers

  # Integration API requests to backend (with path rewriting)
  @integration path /integration/*
  handle @integration {
    rewrite * /api{path}
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Frontend files (default)
  reverse_proxy landing:80 {
    header_up X-Forwarded-For {http.request.remote}
    header_up X-Forwarded-Proto https
  }
}

# ============================================================================
# api.hub42.app - Integration API Only (Block Internal Endpoints)
# ============================================================================
api.hub42.app {
  import security_headers

  # Security: Block any attempt to access internal endpoints
  @internal {
    path /api/internal/*
  }
  handle @internal {
    respond "Internal API not accessible externally" 403
  }

  # Route integration endpoints
  @integration {
    path /api/integration/*
  }
  handle @integration {
    reverse_proxy backend:8081 {
      header_up X-Forwarded-For {http.request.remote}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host {http.request.host}
    }
  }

  # Health endpoint for monitoring
  handle /health {
    reverse_proxy backend:8081
  }

  # Reject everything else
  respond "Not found" 404
}
